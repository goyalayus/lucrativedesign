{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LucrativeDesignRuntimeContentAndAssetAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::lucrative-design-assets-176387411089/content/*",
        "arn:aws:s3:::lucrative-design-assets-176387411089/assets/*"
      ]
    },
    {
      "Sid": "LucrativeDesignRuntimeListPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::lucrative-design-assets-176387411089",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "content/*",
            "assets/*"
          ]
        }
      }
    }
  ]
}
